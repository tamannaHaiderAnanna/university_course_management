@{
    ViewBag.Title = "title";
}
@section styles
{
    
<link href="~/Content/SweetAlert/sweetalert2.css" rel="stylesheet" />
}
<div class="all-content-wrapper">
    <div class="card">
        <u>
            <h4>Unassign All Courses</h4><br/><br/>
        </u>
        <form id="unassignForm" method="POST">
            <input type="submit" class="btn btn-primary btn-lg" id="unassign" value="Unassign Courses"/>
            <div class="form-group">
                <b><i><label>@ViewBag.Message</label></i></b>
            </div>
        </form>
    </div>
</div>
@section scripts
{

    <script src="~/Content/SweetAlert/sweetalert2.js"></script>
    <script>
        $(function() {
            $("#unassign").click(function(e) {
                e.preventDefault();
                Swal.fire({
                    title: 'Are you sure to unassign all courses?',
                    text: "You won't be able to revert this!",
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes!'
                }).then((result) => {
                    if (result.value) {
                    $("#unassignForm").submit();
                        Swal.fire(
                            'Unassigned!',
                            'All courses are unassigned',
                            'success'
                        )
                    }
                });
            });
        })
    </script>
}