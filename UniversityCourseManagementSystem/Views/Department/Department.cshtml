@model UniversityCourseManagementSystem.Models.Department
@{
    ViewBag.Title = "title";
}
@section styles
{
    <style>
        .field-validation-error {
            color: red;
        }

        .input-validation-error {
            border: 1px red solid;
        }
    </style>
}
<div class="all-content-wrapper">
    <div class="card">
        <u>
            <h4>Save Department</h4><br/><br/>
        </u>
        @using (Html.BeginForm())
        {
            <div class="form-group row">
                @Html.LabelFor(n => n.DeptCode, htmlAttributes: new {@class = "col-form-label col-md-2"})
                <div class="col-md-10">
                    @Html.TextBoxFor(n => n.DeptCode, new {htmlAttributes = new {@class = "form-control"}})
                    @Html.ValidationMessageFor(n => n.DeptCode, "", new {@class = "text-danger"})
                </div>
            </div>
            <div class="form-group row">
                @Html.LabelFor(n => n.DeptName, htmlAttributes: new {@class = "col-form-label col-md-2"})
                <div class="col-md-10">
                    @Html.TextBoxFor(n => n.DeptName, new {htmlAttributes = new {@class = "form-control"}})
                    @Html.ValidationMessageFor(n => n.DeptName, "", new {@class = "text-danger"})
                </div>
            </div>
            <div>
                <input type="submit" class="btn btn-primary" value="Save"/>
            </div>
            <div class="form-group">
                <b><i><label for="Massage">@ViewBag.Message</label></i></b>
            </div>
        }
    </div>
</div>
@section scripts
{
    
<script src="~/Scripts/jquery.validate.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.js"></script>
}
