

@{
    ViewBag.Title = "title";
}
@section styles
{

    <link href="~/Content/SweetAlert/sweetalert2.css" rel="stylesheet" />
}
<div class="all-content-wrapper">
    <div class="card">
        <u>
            <h4>Unallocate All Classrooms</h4><br /><br />
        </u>
        <form id="unallocatedRoomForm" method="POST">
            <input type="submit" class="btn btn-primary btn-lg" id="unallocate" value="Unallocate Courses" />
            <div class="form-group">
                <b><i><label>@ViewBag.Message</label></i></b>
            </div>
        </form>
    </div>
</div>
@section scripts
{

    <script src="~/Content/SweetAlert/sweetalert2.js"></script>
    <script>
        $(function() {
            $("#unallocate").click(function(e) {
                e.preventDefault();
                Swal.fire({
                    title: 'Are you sure to unallocate all rooms?',
                    text: "You won't be able to revert this!",
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes!'
                }).then((result) => {
                    if (result.value) {
                    $("#unallocatedRoomForm").submit();
                Swal.fire(
                    'Unallocated!',
                    'All classrooms are unallocated',
                    'success'
                )
            }
            });
        });
        })
    </script>
}
